@model GRCAuthServicesMVC.ViewModels.ApplicationRoleViewModel


        @{
            ViewData["Title"] = "ApplicationRoles";
        }

        <style>
            .bpcl-header {
                background-color: #002F6C;
                color: white;
            }
        </style>

        <main class="container my-5">
            <div class="card shadow">
                <div class="card-header bpcl-header">
                    <h4 class="mb-0">Application Roles Form</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-controller="ApplicationRole" asp-action="AddOrUpdateRoles">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="FormData.RoleId" class="form-label"></label>
                                <input asp-for="FormData.RoleId" class="form-control" placeholder="Enter Role ID" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FormData.ApplicationId" class="form-label"></label>
                                <input asp-for="FormData.ApplicationId" class="form-control" placeholder="Enter Application ID" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FormData.ApplicationRole1" class="form-label"></label>
                                <input asp-for="FormData.ApplicationRole1" class="form-control" placeholder="Enter Application Role" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FormData.BusinessRole" class="form-label"></label>
                                <input asp-for="FormData.BusinessRole" class="form-control" placeholder="Enter Business Role" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FormData.ActiveStatus" class="form-label"></label>
                                <select asp-for="FormData.ActiveStatus" class="form-select">
                                    <option value="">-- Select Status --</option>
                                    <option value="Y">Active</option>
                                    <option value="N">Inactive</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FormData.UpdatedBy" class="form-label"></label>
                                <input asp-for="FormData.UpdatedBy" class="form-control" placeholder="Enter User ID" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FormData.UpdatedOn" class="form-label"></label>
                                <input asp-for="FormData.UpdatedOn" type="datetime-local" class="form-control" placeholder="Select date and time" />
                            </div>
                        </div>
                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-success px-4" name="action" value="add">Add</button>
                            <button type="submit" class="btn btn-success px-4" name="action" value="edit">Edit</button>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <hr>

        <div class="mt-5">
            <form method="get" asp-controller="ApplicationRole" asp-action="GetAllRoles">
                <button type="submit" class="btn btn-primary mb-3">Get All Roles</button>
            </form>

            @if (Model?.Roles?.Any() == true)
            {
                <div class="table-responsive">
                    <div class="mb-3">
                        <form method="get" asp-controller="ApplicationRole" asp-action="GetAllRoles" class="row g-2 align-items-center">
                            <div class="col-auto">
                                <label for="FilterOn" class="col-form-label">Filter By:</label>
                            </div>
                            <div class="col-auto">
                                <select id="FilterOn" name="FilterOn" class="form-select">
                                    <option value="">-- Select Field --</option>
                                    <option value="RoleId">Role ID</option>
                                    <option value="ApplicationId">Application ID</option>
                                    <option value="ApplicationRole1">Application Role</option>
                                    <option value="BusinessRole">Business Role</option>
                                    <option value="ActiveStatus">Status</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <input type="text" name="filterQuery" class="form-control" placeholder="Enter search text..." />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-secondary">Search</button>
                            </div>
                            <div class="col-auto">
                                <a href="@Url.Action("GetAllRoles", "ApplicationRole")" class="btn btn-outline-primary">Clear</a>
                            </div>
                        </form>
                    </div>

                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Role ID</th>
                                <th>Application ID</th>
                                <th>Application Role</th>
                                <th>Business Role</th>
                                <th>Status</th>
                                <th>Updated By</th>
                                <th>Updated On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.Roles)
                            {
                                <tr>
                                    <td>@role.RoleId</td>
                                    <td>@role.ApplicationId</td>
                                    <td>@role.ApplicationRole1</td>
                                    <td>@role.BusinessRole</td>
                                    <td>@role.ActiveStatus</td>
                                    <td>@role.UpdatedBy</td>
                                    <td>@role.UpdatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <nav>
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="GetAllRoles"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="1">First</a>
                            </li>
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="GetAllRoles"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="@(Model.CurrentPage - 1)">Previous</a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="GetAllRoles"
                                       asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                       asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                       asp-route-pagenumber="@i">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="GetAllRoles"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="@(Model.CurrentPage + 1)">Next</a>
                            </li>
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="GetAllRoles"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="@Model.TotalPages">Last</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
            else
            {
                <p class="text-muted">Click the "Get All Roles" button to view data.</p>
            }
        </div>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }
