@model GRCAuthServicesMVC.ViewModels.ApplicationRoleViewModel


        @{
            ViewData["Title"] = "ApplicationRoles";
        }

        <style>
            .bpcl-header {
                background-color: #002F6C;
                color: white;

            }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }
        </style>

   

<div class="mt-5">
    <div class="d-flex gap-2 mb-3">
        <form method="get" asp-controller="ApplicationRole" asp-action="GetAllRoles" class="mb-0">
            <button type="submit" class="btn btn-primary ">Get All Roles</button>
        </form>

        <a class="btn btn-success px-4" asp-controller="ApplicationRole" asp-action="AddApplicationRole">Add</a>
    </div>
            @if (Model?.Roles?.Any() == true)
            {
                <div class="table-responsive">
                    <div class="mb-3">
                        <form method="get" asp-controller="ApplicationRole" asp-action="GetAllRoles" class="row g-2 align-items-center">
                            <div class="col-auto">
                                <label for="FilterOn" class="col-form-label">Filter By:</label>
                            </div>
                            <div class="col-auto">
                                <select id="FilterOn" name="FilterOn" class="form-select">
                                    <option value="">-- Select Field --</option>
                                    <option value="RoleId">Role ID</option>
                                    <option value="ApplicationId">Application ID</option>
                                    <option value="ApplicationRole1">Application Role</option>
                                    <option value="BusinessRole">Business Role</option>
                                    <option value="ActiveStatus">Status</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <input type="text" name="filterQuery" class="form-control" placeholder="Enter search text..." />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-secondary">Search</button>
                            </div>
                            <div class="col-auto">
                                <a href="@Url.Action("GetAllRoles", "ApplicationRole")" class="btn btn-outline-primary">Clear</a>
                            </div>
                        </form>
                    </div>

                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Role ID</th>
                                <th>Application ID</th>
                                <th>Application Role</th>
                                <th>Business Role</th>
                                <th>Status</th>
                                <th>Updated By</th>
                                <th>Updated On</th>
                        <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.Roles)
                            {
                                <tr>
                                    <td>@role.RoleId</td>
                                    <td>@role.ApplicationId</td>
                                    <td>@role.ApplicationRole1</td>
                                    <td>@role.BusinessRole</td>
                                    <td>@role.ActiveStatus</td>
                                    <td>@role.UpdatedBy</td>
                                    <td>@role.UpdatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><a asp-action="EditApplicationRole" name="edit" asp-route-id="@role.RoleId" class="btn btn-sm btn-danger">Edit</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <nav>
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="GetAllRoles"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="1">First</a>
                            </li>
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="GetAllRoles"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="@(Model.CurrentPage - 1)">Previous</a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="GetAllRoles"
                                       asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                       asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                       asp-route-pagenumber="@i">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="GetAllRoles"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="@(Model.CurrentPage + 1)">Next</a>
                            </li>
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="GetAllRoles"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="@Model.TotalPages">Last</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
            else
            {
                <p class="text-muted">Click the "Get All Roles" button to view data.</p>
            }
        </div>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }
