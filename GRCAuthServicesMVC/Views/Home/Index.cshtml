@{
    ViewData["Title"] = "Welcome to Application Management";
}

<style>
    /* Background uses BPCL Primary Blue */
    .bpcl-bg-primary {
        background-color: #017DC5;
    }

    /* Text white for contrast */
    .bpcl-text-primary {
        color: #FFFFFF;
    }

    /* Yellow buttons with dark blue text */
    .btn-bpcl-yellow {
        background-color: #FFD500;
        color: #002F6C;
        font-weight: 600;
        border: none;
    }

        .btn-bpcl-yellow:hover,
        .btn-bpcl-yellow:focus {
            background-color: #e6c200;
            color: #001f4d;
            outline: none;
            box-shadow: 0 0 5px #FFD500;
        }

    /* Outline button in yellow */
    .btn-bpcl-yellow-outline {
        background-color: transparent;
        border: 2px solid #FFD500;
        color: #FFD500;
        font-weight: 600;
    }

        .btn-bpcl-yellow-outline:hover,
        .btn-bpcl-yellow-outline:focus {
            background-color: #FFD500;
            color: #002F6C;
            outline: none;
            box-shadow: 0 0 5px #FFD500;
        }

    footer {
        color: #FFE680; /* lighter yellow for footer text */
    }
</style>

<div class="d-flex flex-column justify-content-center align-items-center min-vh-100 bpcl-bg-primary bpcl-text-primary text-center px-3">
    <h1 class="display-3 fw-bold mb-4">Inventory & Role Management</h1>
    <p class="lead mb-5" style="max-width: 600px;">
        Manage and explore Inventory details along with their associated roles.
        Easily add, update, and view Inventory and their roles securely and efficiently.
    </p>

    <div class="d-flex gap-3 flex-wrap justify-content-center">
        <a asp-controller="Home" asp-action="VApplicationInventory" class="btn btn-bpcl-yellow btn-lg px-4">
            Manage Inventory
        </a>
        <a asp-controller="Home" asp-action="ApplicationRole" class="btn btn-bpcl-yellow-outline btn-lg px-4">
            Manage Roles
        </a>
    </div>

    <footer class="mt-5">
        &copy; 2025 BPCL

    </footer>
</div>
