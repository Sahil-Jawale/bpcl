    @model GRCAuthServicesMVC.ViewModels.ApplicationInventoryViewModel

    @{
        ViewData["Title"] = "ApplicationInventory";
    }


    <style>

    .bpcl-header {
        background-color: #002F6C;
        color: white;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }

</style>

    
   

    <div class="mt-5">
    <div class="d-flex gap-2 mb-3">
        <form method="get" asp-controller="ApplicationInventory" asp-action="Index" class="mb-0">
            <button type="submit" class="btn btn-primary">Get All Applications</button>
        </form>

        <a class="btn btn-success px-4" asp-controller="ApplicationInventory" asp-action="AddApplicationInventory">Add</a>
    </div>


        @if (Model?.ApplicationInventoryList?.Any() == true)
        {
            <div class="table-responsive">
                <div class="mb-3">
                <form method="get" asp-controller="ApplicationInventory" asp-action="Index" class="row g-2 align-items-center">
                        <div class="col-auto">
                            <label for="FilterOn" class="col-form-label">Filter By:</label>
                        </div>
                        <div class="col-auto">
                            <select id="FilterOn" name="FilterOn" class="form-select">
                                <option value="">-- Select Field --</option>
                                <option value="AppInvId">AppInvId</option>
                                <option value="ApplicationId">Application ID</option>
                                <option value="ApplicationDesc">Description</option>
                                <option value="ProcessOwner">Process Owner</option>
                                <option value="ActiveStatus">Status</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <input type="text" name="filterQuery" class="form-control" placeholder="Enter search text..." />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-secondary">Search</button>
                        </div>
                        <div class="col-auto">
                        <a href="@Url.Action("Index", "ApplicationInventory")" class="btn btn-outline-primary">Clear</a>
                        </div>
                    </form>
                </div>

                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>AppInvId</th>
                            <th>ApplicationId</th>
                            <th>Description</th>
                            <th>Process Owner</th>
                            <th>Status</th>
                            <th>Updated On</th>
                            <th>Updated By</th>
                        <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ApplicationInventoryList)
                        {
                            <tr>
                                <td>@item.AppInvId</td>
                                <td>@item.ApplicationId</td>
                                <td>@item.ApplicationDesc</td>
                                <td>@item.ProcessOwner</td>
                                <td>@item.ActiveStatus</td>
                                <td>@item.UpdatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.UpdatedBy</td>
                            <td><a asp-action="EditApplicationInventory" name="edit" asp-route-id="@item.AppInvId" class="btn btn-sm btn-danger">Edit</a></td>

                            </tr>


                        }
                    </tbody>
                </table>

                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                           asp-action="Index"
                               asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                               asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                               asp-route-pagenumber="1">First</a>
                        </li>

                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                           asp-action="Index
"
                               asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                               asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                               asp-route-pagenumber="@(Model.CurrentPage - 1)">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link"
                               asp-action="Index"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                           asp-action="Index"
                               asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                               asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                               asp-route-pagenumber="@(Model.CurrentPage + 1)">Next</a>
                        </li>

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                           asp-action="Index"
                               asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                               asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                               asp-route-pagenumber="@Model.TotalPages">Last</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <p class="text-muted">Click the "Get All Applications" button to view data.</p>
        }
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
