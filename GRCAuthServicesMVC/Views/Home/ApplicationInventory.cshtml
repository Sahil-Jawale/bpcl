    @model GRCAuthServicesMVC.ViewModels.ApplicationInventoryViewModel

    @{
        ViewData["Title"] = "ApplicationInventory";
    }


    <style>

    .bpcl-header {
        background-color: #002F6C;
        color: white;
    }
    </style>




    <main class="container my-5">
        <div class="card shadow">
        <div class="card-header bpcl-header">
                <h4 class="mb-0">Application Inventory Form</h4>
            </div>
            <div class="card-body">
                <form method="post" asp-controller="ApplicationInventory" asp-action="AddOrUpdate">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="AppInvId" class="form-label">AppInvId</label>
                            <input type="number" class="form-control" id="AppInvId" name="AppInvId" required placeholder="Enter App Inventory ID" />
                        </div>

                        <div class="col-md-4">
                            <label for="ApplicationId" class="form-label">Application ID</label>
                            <input type="text" class="form-control" id="ApplicationId" name="ApplicationId" maxlength="6" required placeholder="Enter Application ID" />
                        </div>

                        <div class="col-md-12">
                            <label for="ApplicationDesc" class="form-label">Application Description</label>
                            <input type="text" class="form-control" id="ApplicationDesc" name="ApplicationDesc" maxlength="500" placeholder="Enter a description of the application" />
                        </div>

                        <div class="col-md-6">
                            <label for="ProcessOwner" class="form-label">Process Owner</label>
                            <input type="text" class="form-control" id="ProcessOwner" name="ProcessOwner" maxlength="100" required placeholder="Enter Process Owner's name" />
                        </div>

                        <div class="col-md-6">
                            <label for="ActiveStatus" class="form-label">Active Status</label>
                            <select class="form-select" id="ActiveStatus" name="ActiveStatus" required>
                                <option value="">-- Select Status --</option>
                                <option value="Y">Active</option>
                                <option value="N">Inactive</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="UpdatedOn" class="form-label">Updated On</label>
                            <input type="datetime-local" class="form-control" id="UpdatedOn" name="UpdatedOn" required placeholder="Select last update date/time" />
                        </div>

                        <div class="col-md-6">
                            <label for="UpdatedBy" class="form-label">Updated By (User ID)</label>
                            <input type="number" class="form-control" id="UpdatedBy" name="UpdatedBy" required placeholder="Enter your User ID" />
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-success px-4" name="action" value="add">Add</button>
                        <button type="submit" class="btn btn-success px-4" name="action" value="edit">Edit</button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <hr>

    <div class="mt-5">
        <form method="get" asp-controller="ApplicationInventory" asp-action="GetAll">
            <button type="submit" class="btn btn-primary mb-3">Get All Applications</button>
        </form>

        @if (Model?.ApplicationInventoryList?.Any() == true)
        {
            <div class="table-responsive">
                <div class="mb-3">
                    <form method="get" asp-controller="ApplicationInventory" asp-action="GetAll" class="row g-2 align-items-center">
                        <div class="col-auto">
                            <label for="FilterOn" class="col-form-label">Filter By:</label>
                        </div>
                        <div class="col-auto">
                            <select id="FilterOn" name="FilterOn" class="form-select">
                                <option value="">-- Select Field --</option>
                                <option value="AppInvId">AppInvId</option>
                                <option value="ApplicationId">Application ID</option>
                                <option value="ApplicationDesc">Description</option>
                                <option value="ProcessOwner">Process Owner</option>
                                <option value="ActiveStatus">Status</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <input type="text" name="filterQuery" class="form-control" placeholder="Enter search text..." />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-secondary">Search</button>
                        </div>
                        <div class="col-auto">
                            <a href="@Url.Action("GetAll", "ApplicationInventory")" class="btn btn-outline-primary">Clear</a>
                        </div>
                    </form>
                </div>

                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>AppInvId</th>
                            <th>ApplicationId</th>
                            <th>Description</th>
                            <th>Process Owner</th>
                            <th>Status</th>
                            <th>Updated On</th>
                            <th>Updated By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ApplicationInventoryList)
                        {
                            <tr>
                                <td>@item.AppInvId</td>
                                <td>@item.ApplicationId</td>
                                <td>@item.ApplicationDesc</td>
                                <td>@item.ProcessOwner</td>
                                <td>@item.ActiveStatus</td>
                                <td>@item.UpdatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="GetAll"
                               asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                               asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                               asp-route-pagenumber="1">First</a>
                        </li>

                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="GetAll"
                               asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                               asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                               asp-route-pagenumber="@(Model.CurrentPage - 1)">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="GetAll"
                                   asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                                   asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                                   asp-route-pagenumber="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="GetAll"
                               asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                               asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                               asp-route-pagenumber="@(Model.CurrentPage + 1)">Next</a>
                        </li>

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="GetAll"
                               asp-route-FilterOn="@Context.Request.Query["FilterOn"]"
                               asp-route-filterQuery="@Context.Request.Query["filterQuery"]"
                               asp-route-pagenumber="@Model.TotalPages">Last</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <p class="text-muted">Click the "Get All Applications" button to view data.</p>
        }
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
